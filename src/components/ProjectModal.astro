---
---
<div
  id="project-modal"
  class="modal-overlay fixed inset-0 z-[9999] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
  style="background: rgba(10, 10, 10, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <div
    class="modal-content relative w-full max-w-2xl max-h-[85vh] overflow-y-auto p-6 sm:p-8 rounded-2xl border border-white/10 shadow-2xl scale-95 transition-transform duration-300"
    style="background: var(--card-strong); border: 1px solid var(--border); border-radius: var(--radius-xl);"
  >
    <button
      id="close-modal"
      class="modal-close absolute top-4 right-4 p-2 rounded-lg border transition-all duration-200 z-10"
      style="color: var(--text-muted); background: var(--surface); border-color: var(--border);"
      aria-label="Close details modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div id="modal-body" class="relative"></div>
  </div>
</div>
