---
interface Props {
  id: string;
  title: string;
  shortDesc: string;
  tech: string[];
  bgGradient: string;
  icon: string;
  github?: string;
  demo?: string;
  showActions?: boolean;
}

const { id, title, shortDesc, tech, bgGradient, icon, github, demo, showActions = false } = Astro.props;

const iconPaths: Record<string, string> = {
  monitor: `<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>`,
  box: `<rect x="2" y="2" width="20" height="20" rx="2" ry="2"></rect><path d="M7 2v20M17 2v20M2 12h20M2 7h20M2 17h20"></path>`,
  calculator: `<rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="14"></line><line x1="16" y1="18" x2="16" y2="18"></line><line x1="12" y1="14" x2="12" y2="14"></line><line x1="12" y1="18" x2="12" y2="18"></line><line x1="8" y1="14" x2="8" y2="14"></line><line x1="8" y1="18" x2="8" y2="18"></line>`,
  book: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>`,
  taxi: `<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>`,
  "map-pin": `<path d="m2 22 5-5-5-5 5-5-5-5"/><path d="M8 2v20"/><path d="m22 22-5-5 5-5-5-5 5-5"/><path d="M16 2v20"/>`
};

const currentIconPath = iconPaths[icon] || iconPaths.monitor;
---

<div
  class="project-card"
  data-project={id}
  style={!showActions ? "cursor: pointer;" : undefined}
>
  <div class="project-showcase">
    <div class="monitor-screen" style={`background: ${bgGradient};`}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="64"
        height="64"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="1"
        style="opacity: 0.5;"
        set:html={currentIconPath}
      />
    </div>
  </div>

  <div class="project-info">
    <div class="project-header">
      <h3 class="project-title">{title}</h3>
      <div class="active-indicator"></div>
    </div>

    <p class="project-desc">{shortDesc}</p>

    <div class="tech-stack">
      {tech.map((t) => (
        <span class="tech-tag">{t}</span>
      ))}
    </div>

    {showActions && (
      <div class="card-actions">
        <a href="/projects/" class="btn btn-secondary btn-sm" aria-label={`Read more details about ${title}`}>Read More</a>
        {github && (
          <a href={github} class="btn btn-secondary btn-sm" target="_blank" rel="noopener noreferrer">Source</a>
        )}
        {demo && (
          <a href={demo} class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer">Live Demo</a>
        )}
      </div>
    )}
  </div>
</div>
