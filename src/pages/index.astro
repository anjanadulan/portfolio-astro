---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.jpg';
import ProjectModal from '../components/ProjectModal.astro';

const featuredProjects = projects.slice(0, 5);
---

<Layout>
  <!-- ═══ HERO ═══ -->
  <section id="home" class="hero">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-label">Welcome to my portfolio</span>
        <h1 class="hero-title">Anjana <span class="text-accent">Wijerathna</span></h1>
        <div class="hero-tagline-wrapper">
          <span>I am</span>
          <span class="hero-tagline">
            <span class="typewriter-text" id="typewriter"></span>
            <span class="typewriter-cursor">|</span>
          </span>
        </div>
        <p class="hero-bio">
          Driven by a passion for bridging software and hardware, I specialize in enterprise Java applications and IoT engineering.
        </p>
        <div class="hero-buttons">
          <a href="#projects" class="btn btn-primary">View Projects</a>
          <a href="#contact" class="btn btn-secondary">Contact Me</a>
          <a href="resume.pdf" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Resume
          </a>
        </div>
        <div class="hero-socials">
          <a href="https://github.com/anjanadulan" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/anjanawijerathna/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="https://www.instagram.com/__anj.u/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2C4.243 2 2 4.243 2 7v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm10 2c1.654 0 3 1.346 3 3v10c0 1.654-1.346 3-3 3H7c-1.654 0-3-1.346-3-3V7c0-1.654 1.346-3 3-3h10zm-5 3c-2.757 0-5 2.243-5 5s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5zm0 2a3 3 0 100 6 3 3 0 000-6zm4.5-.5a1 1 0 110 2 1 1 0 010-2z"/></svg>
          </a>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <div class="hero-image-container">
          <Image
            src={profileImage}
            alt="Anjana Wijerathna"
            class="hero-image"
            widths={[280, 380]}
            sizes="(max-width: 768px) 280px, 380px"
            width={380}
            height={475}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Available</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT ═══ -->
  <section id="about" class="about">
    <div class="container">
      <div class="section-header">
        <span class="section-label">About</span>
        <h2 class="section-title">Who I Am</h2>
      </div>

      <div class="about-grid">
        <div class="about-content">
          <div class="about-text-grid">
            <div class="about-text-left">
              <h3 class="about-heading">Who I Am</h3>
              <p class="about-subheading">A brief look into my journey as a developer and engineer.</p>
            </div>
            <div class="about-text-right">
              <p class="about-name">Anjana Wijerathna (Anjana Dulan Nimsara)</p>
              <p class="about-text">
                Driven by a passion for bridging software and hardware, I am a software developer and engineer specializing in enterprise Java applications and IoT systems. Working professionally as <strong>Anjana Wijerathna</strong> (full legal name: <strong>Anjana Dulan Nimsara</strong>), my work spans from building robust, full-stack web platforms using Spring Boot and React, to designing smart hardware systems with Arduino and embedded technologies.
              </p>
            </div>
          </div>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-value">2+</div>
              <div class="stat-label">Years Experience</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">10+</div>
              <div class="stat-label">Projects Done</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">3+</div>
              <div class="stat-label">Technologies</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">15+</div>
              <div class="stat-label">Happy Clients</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SKILLS — Pinned Scroll Section ═══ -->
  <section id="skills" class="skills">
    <div class="skills-pin-wrapper">
      <div class="container">
        <div class="section-header center">
          <span class="section-label">Core Capabilities</span>
          <h2 class="section-title">Technical Arsenal</h2>
          <p class="section-subtitle">The tools and technologies I use to build modern, scalable applications.</p>
        </div>

        <div class="skills-details">
          <div class="skill-detail-card" id="skill-frontend" data-skill-index="0">
            <h3>Frontend Mastery</h3>
            <p class="detail-desc">Crafting pixel-perfect, interactive, and responsive user interfaces with modern frameworks.</p>
            <div class="skill-items">
              <div class="skill-item">
                <img src="/icons/html5.svg" alt="HTML5" width="32" height="32" loading="lazy" />
                <span class="skill-name">HTML5</span>
              </div>
              <div class="skill-item">
                <img src="/icons/css3.svg" alt="CSS3" width="32" height="32" loading="lazy" />
                <span class="skill-name">CSS3</span>
              </div>
              <div class="skill-item">
                <img src="/icons/javascript.svg" alt="JavaScript" width="32" height="32" loading="lazy" />
                <span class="skill-name">JavaScript</span>
              </div>
              <div class="skill-item">
                <img src="/icons/typescript.svg" alt="TypeScript" width="32" height="32" loading="lazy" />
                <span class="skill-name">TypeScript</span>
              </div>
              <div class="skill-item">
                <img src="/icons/react.svg" alt="React" width="32" height="32" loading="lazy" />
                <span class="skill-name">React</span>
              </div>
              <div class="skill-item">
                <img src="/icons/nextjs.svg" class="theme-icon-invert" alt="Next.js" width="32" height="32" loading="lazy" />
                <span class="skill-name">Next.js</span>
              </div>
              <div class="skill-item">
                <img src="/icons/tailwindcss.svg" alt="Tailwind" width="32" height="32" loading="lazy" />
                <span class="skill-name">Tailwind</span>
              </div>
            </div>
          </div>

          <div class="skill-detail-card" id="skill-backend" data-skill-index="1">
            <h3>Backend Powerhouse</h3>
            <p class="detail-desc">Building scalable, secure, and efficient server-side architectures.</p>
            <div class="skill-items">
              <div class="skill-item">
                <img src="/icons/java.svg" alt="Java" width="32" height="32" loading="lazy" />
                <span class="skill-name">Java</span>
              </div>
              <div class="skill-item">
                <img src="/icons/spring.svg" alt="Spring" width="32" height="32" loading="lazy" />
                <span class="skill-name">Spring Boot</span>
              </div>
              <div class="skill-item">
                <img src="/icons/nodejs.svg" alt="Node.js" width="32" height="32" loading="lazy" />
                <span class="skill-name">Node.js</span>
              </div>
              <div class="skill-item">
                <img src="/icons/express.svg" class="theme-icon-invert" alt="Express" width="32" height="32" loading="lazy" />
                <span class="skill-name">Express</span>
              </div>
              <div class="skill-item">
                <img src="/icons/nestjs.svg" alt="NestJS" width="32" height="32" loading="lazy" />
                <span class="skill-name">NestJS</span>
              </div>
            </div>
          </div>

          <div class="skill-detail-card" id="skill-database" data-skill-index="2">
            <h3>Data Architecture</h3>
            <p class="detail-desc">Designing optimized data models and managing complex query systems.</p>
            <div class="skill-items">
              <div class="skill-item">
                <img src="/icons/postgresql.svg" alt="PostgreSQL" width="32" height="32" loading="lazy" />
                <span class="skill-name">PostgreSQL</span>
              </div>
              <div class="skill-item">
                <img src="/icons/mysql.svg" alt="MySQL" width="32" height="32" loading="lazy" />
                <span class="skill-name">MySQL</span>
              </div>
              <div class="skill-item">
                <img src="/icons/mongodb.svg" alt="MongoDB" width="32" height="32" loading="lazy" />
                <span class="skill-name">MongoDB</span>
              </div>
              <div class="skill-item">
                <img src="/icons/prisma.svg" class="theme-icon-invert" alt="Prisma" width="32" height="32" loading="lazy" />
                <span class="skill-name">Prisma ORM</span>
              </div>
              <div class="skill-item">
                <img src="/icons/redis.svg" alt="Redis" width="32" height="32" loading="lazy" />
                <span class="skill-name">Redis</span>
              </div>
            </div>
          </div>

          <div class="skill-detail-card" id="skill-tools" data-skill-index="3">
            <h3>Hardware & Tools</h3>
            <p class="detail-desc">Bridging software and physical systems with IoT and modern dev tools.</p>
            <div class="skill-items">
              <div class="skill-item">
                <img src="/icons/arduino.svg" alt="Arduino" width="32" height="32" loading="lazy" />
                <span class="skill-name">Arduino</span>
              </div>
              <div class="skill-item">
                <img src="/icons/cplusplus.svg" alt="C++" width="32" height="32" loading="lazy" />
                <span class="skill-name">C++</span>
              </div>
              <div class="skill-item">
                <img src="/icons/git.svg" alt="Git" width="32" height="32" loading="lazy" />
                <span class="skill-name">Git</span>
              </div>
              <div class="skill-item">
                <img src="/icons/github.svg" class="theme-icon-invert" alt="GitHub" width="32" height="32" loading="lazy" />
                <span class="skill-name">GitHub</span>
              </div>
              <div class="skill-item">
                <img src="/icons/electron.svg" alt="Electron" width="32" height="32" loading="lazy" />
                <span class="skill-name">Electron</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PROJECTS ═══ -->
  <section id="projects" class="projects-section">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">Selected Work</span>
        <h2 class="section-title">Featured Projects</h2>
        <p class="section-subtitle">A curated collection of my most impactful work across web, enterprise, and IoT.</p>
      </div>

      <!-- 3D Layered Carousel Wrapper -->
      <div class="carousel-wrapper">
        <div class="carousel-container" id="project-carousel">
          <div class="carousel-track">
            {featuredProjects.map((p, index) => (
              <div class="carousel-item" data-index={index}>
                <ProjectCard
                  id={p.id}
                  title={p.title}
                  shortDesc={p.desc}
                  tech={p.tech}
                  bgGradient={p.bgGradient}
                  icon={p.icon}
                  github={p.github}
                  demo={p.demo}
                  showActions={true}
                />
              </div>
            ))}
          </div>

          <!-- Navigation Controls -->
          <button class="carousel-nav-btn prev-btn" id="carousel-prev" aria-label="Previous project">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          </button>
          <button class="carousel-nav-btn next-btn" id="carousel-next" aria-label="Next project">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>

          <!-- Indicators / Dots -->
          <div class="carousel-dots">
            {featuredProjects.map((_, index) => (
              <button class="carousel-dot" data-index={index} aria-label={`Go to slide ${index + 1}`}></button>
            ))}
          </div>
        </div>
      </div>

      <div class="extra-projects">
        <a href="/projects/" class="btn btn-primary">View All Projects</a>
        <a href="https://github.com/anjanadulan?tab=repositories" target="_blank" rel="noopener noreferrer" class="github-link">Browse GitHub</a>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT ═══ -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">Connect</span>
        <h2 class="section-title">Get In Touch</h2>
        <p class="section-subtitle">I'm always open to new opportunities, collaborations, or just a friendly chat.</p>
      </div>

      <div class="contact-content">
        <p class="contact-text">
          Feel free to reach out! I'm currently available for freelance work and open to full-time opportunities.
        </p>

        <form action="https://api.web3forms.com/submit" method="POST" class="contact-form">
          <input type="hidden" name="access_key" value="c407f4b0-9f28-4076-a31a-af42511d739e">

          <div class="form-group">
            <input type="text" name="name" placeholder="Your Name" required class="form-input" autocomplete="name">
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Your Email" required class="form-input" autocomplete="email">
          </div>
          <div class="form-group">
            <textarea name="message" placeholder="Your Message" required class="form-input" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-full" style="margin-bottom: 1.5rem;">Send Message</button>
        </form>

        <div class="contact-buttons">
          <a href="mailto:dulannimsara453@gmail.com" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Send Email
          </a>
          <a href="https://www.linkedin.com/in/anjanawijerathna/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn
          </a>
        </div>
        <div class="contact-socials">
          <a href="https://github.com/anjanadulan" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.instagram.com/__anj.u/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2C4.243 2 2 4.243 2 7v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm10 2c1.654 0 3 1.346 3 3v10c0 1.654-1.346 3-3 3H7c-1.654 0-3-1.346-3-3V7c0-1.654 1.346-3 3-3h10zm-5 3c-2.757 0-5 2.243-5 5s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5zm0 2a3 3 0 100 6 3 3 0 000-6zm4.5-.5a1 1 0 110 2 1 1 0 010-2z"/></svg>
          </a>
          <a href="mailto:dulannimsara453@gmail.com" class="social-icon" aria-label="Email">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  <ProjectModal />
</Layout>
